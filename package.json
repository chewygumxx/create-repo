{
    "name": "@chewygumxx/create-repo",
    "version": "3.2.1",
    "description": "Creates a GitHub repository from a bundled template: bun create @chewygumxx/repo",
    "keywords": [
        "create",
        "template",
        "repository"
    ],
    "homepage": "https://github.com/chewygumxx/create-repo#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/chewygumxx/create-repo.git"
    },
    "license": "GPL-3.0-only",
    "type": "module",
    "bin": {
        "create-repo": "bin/create-repo.js"
    },
    "files": [
        "bin",
        "lib",
        "templates"
    ],
    "scripts": {
        "check": "bun run typecheck && bun run lint:biome && bun run lint:md && bun run lint:yaml && bun run lint:toml && bun run lint:emdash && bun run lint:editorconfig && bun run lint:templates && bun run test",
        "commit": "cz",
        "format": "biome format --write . && bun run format:yaml && bun run format:toml",
        "format:check": "biome format .",
        "format:toml": "git ls-files -z '*.toml' | xargs -0 -r tombi format",
        "format:yaml": "git ls-files -z '*.yaml' '*.yml' | xargs -0 -r prettier --write --log-level warn",
        "lint": "biome lint .",
        "lint:biome": "biome ci .",
        "lint:editorconfig": "editorconfig-checker -disable-indent-size",
        "lint:emdash": "git grep -nIP --untracked '\\x{2014}'; test $? -eq 1",
        "lint:md": "git ls-files -z '*.md' | xargs -0 -r remark --frail --quiet --no-stdout",
        "lint:templates": "rm -rf .templates && bun scripts/materialize.js --all .templates && for dir in .templates/*/; do (cd \"$dir\" && biome ci --vcs-use-ignore-file=false . && editorconfig-checker -disable-indent-size .) || exit 1; done",
        "lint:toml": "git ls-files -z '*.toml' | xargs -0 -r tombi format --check && git ls-files -z '*.toml' | xargs -0 -r tombi lint --error-on-warnings",
        "lint:yaml": "git ls-files -z '*.yaml' '*.yml' | xargs -0 -r prettier --check && git ls-files -z '*.yaml' '*.yml' | xargs -0 -r yamllint --strict",
        "prepare": "test -d node_modules/husky && husky || true",
        "test": "bun test ./test/",
        "typecheck": "tsc"
    },
    "config": {
        "commitizen": {
            "path": "@chewygumxx/cz-commitlint"
        }
    },
    "prettier": "@chewygumxx/prettier-config",
    "remarkConfig": {
        "plugins": [
            "@chewygumxx/remark-preset"
        ]
    },
    "dependencies": {
        "jsonc-parser": "^3.3.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@chewygumxx/biome-config": "^1.0.0",
        "@chewygumxx/commitlint-config": "^1.1.0",
        "@chewygumxx/cspell-config": "^1.0.1",
        "@chewygumxx/cz-commitlint": "^1.0.2",
        "@chewygumxx/prettier-config": "^1.0.1",
        "@chewygumxx/remark-preset": "^1.0.3",
        "@chewygumxx/yamllint-config": "^1.0.0",
        "@commitlint/cli": "^21.2.2",
        "@types/bun": "^1.4.2",
        "commitizen": "^4.3.2",
        "cspell": "^10.3.6",
        "husky": "^9.1.7",
        "prettier": "^3.9.9",
        "remark-cli": "^12.0.1",
        "typescript": "^7.0.2"
    },
    "engines": {
        "bun": ">=1.4"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
