#!/usr/bin/env sh
# vim:set expandtab shiftwidth=4 filetype=sh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/repo-tmpl.git
# ::: :/.husky/pre-commit
#
#

set -e

bunx --bun --no-install tsc
bunx --bun --no-install biome check --staged --no-errors-on-unmatched

git diff -z --cached --name-only --diff-filter=ACMR -- '*.md' |
    xargs -0 -r bunx --bun --no-install remark --frail --quiet --no-stdout
git diff -z --cached --name-only --diff-filter=ACMR -- '*.md' |
    xargs -0 -r bunx --bun --no-install markdownlint-cli2

yaml=$(git diff --cached --name-only --diff-filter=ACMR -- '*.yaml' '*.yml')
if [ -n "$yaml" ]; then
    git diff -z --cached --name-only --diff-filter=ACMR -- '*.yaml' '*.yml' |
        xargs -0 bunx --bun --no-install prettier --check
    git diff -z --cached --name-only --diff-filter=ACMR -- '*.yaml' '*.yml' |
        xargs -0 yamllint --strict
fi

toml=$(git diff --cached --name-only --diff-filter=ACMR -- '*.toml')
if [ -n "$toml" ]; then
    git diff -z --cached --name-only --diff-filter=ACMR -- '*.toml' |
        xargs -0 tombi format --check
    git diff -z --cached --name-only --diff-filter=ACMR -- '*.toml' |
        xargs -0 tombi lint --error-on-warnings
fi

sh=$(git diff -z --cached --name-only --diff-filter=ACMR | xargs -0 -r shfmt -f)
if [ -n "$sh" ]; then
    printf '%s\n' "$sh" | tr '\n' '\0' | xargs -0 shfmt -d
    printf '%s\n' "$sh" | tr '\n' '\0' |
        xargs -0 shellcheck --rcfile \
            node_modules/@chewygumxx/shellcheck-config/config.shellcheckrc
fi

git diff -z --cached --name-only --diff-filter=ACMR -- \
    '.github/workflows/*.yaml' '.github/workflows/*.yml' |
    xargs -0 -r actionlint -config-file \
        node_modules/@chewygumxx/actionlint-config/config.yaml

git diff -z --cached --name-only --diff-filter=ACMR |
    xargs -0 -r editorconfig-checker -config \
        node_modules/@chewygumxx/editorconfig-checker-config/config.json

git diff -z --cached --name-only --diff-filter=ACMR |
    xargs -0 -r bunx --bun --no-install cspell \
        --no-progress --no-summary --no-must-find-files
git diff -z --cached --name-only --diff-filter=ACMR |
    xargs -0 -r bunx --bun --no-install secretlint

# U+2014 as UTF-8 bytes, so this file does not trip its own check.
emdash=$(printf '\342\200\224')
if git diff --cached -U0 | grep '^+' | grep -q "$emdash"; then
    echo "Em dash (U+2014) in staged changes; em dashes are prohibited." >&2
    exit 1
fi
