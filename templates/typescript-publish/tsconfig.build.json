{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "dist",
        "rootDir": "src",
        "declaration": true,
        "rewriteRelativeImportExtensions": true
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.ts"]
}
