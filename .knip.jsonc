// vim:set expandtab shiftwidth=4 filetype=jsonc:
// SPDX-License-Identifier: GPL-3.0-only

//
//
// ~chewygumxx/create-repo.git
// ::: :/.knip.jsonc
//
//

// https://knip.dev/reference/configuration
//
// knip finds the entry files by itself; this file lists only what it cannot
// see. Files are globs; dependencies and binaries, regular expressions.
{
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
    // `bun test ./test/` finds these by name.
    "entry": ["test/*.test.js"],
    // The bundled templates are copied out to new repositories, never run
    // here.
    "ignore": ["templates/**"],
    "ignoreDependencies": [
        // The shared configurations, named by path in the hk steps or the
        // mise conf.d link, by `extends` or `import`, or from
        // `.secretlintrc.json`.
        "@chewygumxx/.+",
        // Extended by @chewygumxx/commitlint-config, which depends on them.
        "@commitlint/config-conventional",
        // Run by the hk steps, which knip does not read.
        "publint",
        "secretlint",
        "sort-package-json",
        "sync-header-metadata"
    ],
    // The tool manager, which `package.json` runs for its `check`.
    "ignoreBinaries": ["mise"],
    // Configured under `.config/`, where neither tool looks unless the hk
    // steps pass the path.
    "prettier": {
        "config": [".config/prettierrc.json"]
    },
    "remark": {
        "config": [".config/remarkrc.json"]
    }
}
